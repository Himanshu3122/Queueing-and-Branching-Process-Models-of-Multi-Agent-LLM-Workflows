# Copy to .env (never commit .env). No secrets are required by this project.
# Path to the profiles YAML loaded by the HTTP API.
AGENTQ_PROFILES=configs/profiles.yaml
# Upper bound on grid points per API request (protects the server from oversized requests).
AGENTQ_MAX_GRID_POINTS=60000
# uvicorn bind settings used by the Docker image / `agentq serve`
AGENTQ_HOST=0.0.0.0
AGENTQ_PORT=8000
